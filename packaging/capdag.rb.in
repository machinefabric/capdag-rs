# Generated by the workspace package publish — do not edit by hand.
class Capdag < Formula
  desc "Machine-notation and single-cap executor CLI"
  homepage "https://capdag.com"
  version "@{version}"

  on_macos do
    if Hardware::CPU.arm?
      @{platform_block:darwin-arm64}
    else
      @{platform_block:darwin-x86_64}
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      @{platform_block:linux-arm64}
    else
      @{platform_block:linux-x86_64}
    end
  end

  def install
    # The archive extracts to @{bundle_dir}/{@{package},bundled-cartridges}. Install the whole
    # bundle into libexec and expose only a symlink on PATH — @{package} resolves its
    # bundled-cartridges/ tree relative to the symlink's canonicalized real path.
    libexec.install Dir["@{bundle_dir}/*"]
    bin.install_symlink libexec/"@{package}"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/@{package} --version")
  end
end
