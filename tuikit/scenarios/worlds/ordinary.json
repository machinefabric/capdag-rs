        { "log": { "step": "model-download", "level": "info", "message": "verified sha256 of Qwen3-4B-Instruct-2507-Q4_K_M.gguf" } }
      ],
      "end": {
        "completed": {
          "outputs": {
            "download-result": "{\"model_spec\":\"hf:unsloth/Qwen3-4B-Instruct-2507-GGUF\",\"state\":\"complete\",\"total_bytes\":2497281312}"
          }
        }
      },
      "on_stop": {
