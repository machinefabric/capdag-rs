{
  "title": "List the machines that make text of a file",
  "world": "ordinary",
  "args": [
    "plan",
    "report.pdf",
    "--to",
    "txt"
  ],
  "modes": {
    "plain": {
      "expect": {
        "exit": 0,
        "stdout": [
          "5 machines make txt of 1 pdf:",
          "[(input=pdf) -> disbind-pdf -> (output=page-text)]",
          "[(input=png) -> ocr-gguf -> (output=digitized-text)]"
        ],
        "shown": [
          "Run one:  capdag run '<machine>' report.pdf"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 0,
        "stdout": [
          "\"type\":\"machine\"",
          "\"index\":5"
        ]
      }
    }
  }
}
