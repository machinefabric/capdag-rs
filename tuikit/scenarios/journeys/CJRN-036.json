{
  "title": "A typo is answered with the command it most likely meant",
  "world": "ordinary",
  "args": ["cpas"],
  "modes": {
    "plain": { "expect": { "exit": 2, "shown": ["there is no command `cpas`", "did you mean `capdag caps`?"] } },
    "json": { "expect": { "exit": 2, "stdout": ["\"type\":\"error\""] } }
  }
}
