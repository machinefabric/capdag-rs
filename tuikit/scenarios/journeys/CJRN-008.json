{
  "title": "Choose the machine that makes text, run nothing, and keep it in a file",
  "world": "ordinary",
  "args": [
    "run",
    "report.pdf",
    "--to",
    "txt",
    "--dry-run"
  ],
  "modes": {
    "inline": {
      "keys": [
        {
          "wait": "Choose the machine"
        },
        {
          "press": "Enter"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "[(input=pdf) -> "
        ],
        "shown": [
          "Run it with: capdag run '[(input=pdf) -> "
        ],
        "absent": [
          "disbind-pdf  done"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 0,
        "stdout": [
          "\"type\":\"machine\"",
          "\"index\":1"
        ]
      }
    }
  }
}
