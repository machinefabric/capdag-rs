{
  "title": "Choose among the machines that make text, and run the one chosen",
  "world": "ordinary",
  "args": [
    "run",
    "report.pdf",
    "--to",
    "txt",
    "-o",
    "out"
  ],
  "modes": {
    "inline": {
      "keys": [
        {
          "wait": "Choose the machine"
        },
        {
          "press": "Enter"
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "report · 1.page-text.txt",
          "report · 2.page-text.txt",
          "report · 3.page-text.txt"
        ],
        "shown": [
          "Run it again with: capdag run '[(input=pdf) -> disbind-pdf -> (output=page-text)]' --input pdf=@report.pdf -o out",
          "✓ report.pdf  1 step"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 2,
        "stdout": [
          "\"type\":\"choice\"",
          "\"of\":\"the machine\"",
          "\"type\":\"error\""
        ],
        "absent": [
          "\"type\":\"run_finished\""
        ]
      }
    }
  }
}
