{
  "title": "An encrypted PDF is refused as input",
  "world": "failing",
  "args": [
    "run",
    "[doc -> disbind-pdf -> pages]",
    "locked.pdf",
    "-o",
    "pages"
  ],
  "modes": {
    "plain": {
      "expect": {
        "exit": 1,
        "shown": [
          "✗ locked.pdf  1 step",
          "disbind-pdf refused its input",
          "the document is encrypted, and no password was given"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 1,
        "stdout": [
          "\"problem\":\"disbind-pdf refused its input\""
        ]
      }
    }
  }
}
