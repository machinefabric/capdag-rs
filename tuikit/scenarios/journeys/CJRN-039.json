{
  "title": "A page's summary fails, its policy tolerates it, and the run ends with what it has",
  "world": "tolerant",
  "args": [
    "run",
    "summaries.machine",
    "report.pdf",
    "-o",
    "out"
  ],
  "modes": {
    "inline": {
      "expect": {
        "exit": 3,
        "stdout": [
          "report · 2.summary.txt"
        ],
        "shown": [
          "tolerated"
        ],
        "absent": [
          "report · 3.summary.txt"
        ]
      }
    },
    "plain": {
      "expect": {
        "exit": 3,
        "stdout": [
          "report · 1.summary.txt",
          "report · 2.summary.txt"
        ],
        "shown": [
          "warn: page 2: the model ran out of memory",
          "failed, and tolerated: summarize-en (item 2) [resource] — the model ran out of memory on page 2",
          "· tolerated"
        ],
        "absent": [
          "report · 3.summary.txt"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 3,
        "stdout": [
          "\"type\":\"tolerated\"",
          "\"item\":1",
          "\"outcome\":\"tolerated\""
        ]
      }
    }
  }
}
