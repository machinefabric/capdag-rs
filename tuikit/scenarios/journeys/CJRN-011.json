{
  "title": "Run a machine of one step on a file",
  "world": "ordinary",
  "args": [
    "run",
    "[doc -> disbind-pdf -> pages]",
    "report.pdf",
    "-o",
    "pages"
  ],
  "modes": {
    "full_screen": {
      "expect": {
        "exit": 0,
        "screen": [
          "{dir}/pages/report · 1.pages.txt",
          "{dir}/pages/report · 2.pages.txt",
          "{dir}/pages/report · 3.pages.txt",
          "✓ report.pdf  1 step · {*} s"
        ]
      }
    },
    "inline": {
      "expect": {
        "exit": 0,
        "stdout": [
          "report · 1.pages.txt",
          "report · 3.pages.txt"
        ],
        "screen": [
          "✓ report.pdf  1 step · {*} s",
          "  → {dir}/pages/report · 1.pages.txt",
          "  → {dir}/pages/report · 2.pages.txt",
          "  → {dir}/pages/report · 3.pages.txt"
        ]
      }
    },
    "plain": {
      "expect": {
        "exit": 0,
        "stdout": [
          "report · 1.pages.txt"
        ],
        "shown": [
          "[1/1] disbind-pdf    0%",
          "[1/1] disbind-pdf  done",
          "✓ report.pdf  1 step"
        ]
      }
    },
    "json": {
      "expect": {
        "exit": 0,
        "stdout": [
          "\"step\":\"disbind-pdf\"",
          "\"state\":\"done\"",
          "\"type\":\"run_finished\"",
          "\"outcome\":\"completed\""
        ]
      }
    }
  }
}
