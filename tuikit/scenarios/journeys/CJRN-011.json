{
  "title": "Run a capability on a file",
  "world": "ordinary",
  "args": ["run", "disbind-pdf", "report.pdf", "-o", "pages"],
  "modes": {
    "full_screen": { "expect": { "exit": 0, "shown": ["report.output.0.txt", "✓ report.pdf  1 step"] } },
    "inline": { "expect": { "exit": 0, "stdout": ["report.output.0.txt", "report.output.2.txt"], "shown": ["✓ report.pdf  1 step"] } },
    "plain": {
      "expect": {
        "exit": 0,
        "stdout": ["report.output.0.txt"],
        "shown": ["[1/1] disbind-pdf    0%", "[1/1] disbind-pdf  done", "✓ report.pdf  1 step"]
      }
    },
    "json": {
      "expect": {
        "exit": 0,
        "stdout": ["\"step\":\"disbind-pdf\"", "\"state\":\"done\"", "\"type\":\"run_finished\"", "\"outcome\":\"completed\""]
      }
    }
  }
}
