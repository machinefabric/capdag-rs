{
  "title": "Stop a run with Ctrl-C: what started finishes",
  "world": "ordinary",
  "args": ["run", "summaries.machine", "report.pdf", "-o", "out"],
  "modes": {
    "inline": {
      "keys": [{ "wait": "summarize-en" }, { "press": "Ctrl-C" }],
      "expect": {
        "exit": 130,
        "stdout": ["report.summary.2.txt"],
        "shown": ["Stopping: nothing new starts; what started finishes and is written.", "· stopped"]
      }
    }
  }
}
